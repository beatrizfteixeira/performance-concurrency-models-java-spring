# Copie para .env na mesma pasta do docker-compose.yml:
#   cp env.example .env
#
# PostgreSQL (container)
POSTGRES_DB=testdb
POSTGRES_USER=testuser
POSTGRES_PASSWORD=testpass
POSTGRES_PORT=5432
POSTGRES_MAX_CONNECTIONS=2000
POSTGRES_SHARED_BUFFERS=256MB
POSTGRES_WORK_MEM=1MB
POSTGRES_SYNCHRONOUS_COMMIT=off

# Em maquina com bastante RAM para o experimento do orientador (1500+ conexoes):
# POSTGRES_SHARED_BUFFERS=4GB

# ---------------------------------------------------------------------------
# Apps na MESMA maquina que o Docker (localhost)
# ---------------------------------------------------------------------------
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/testdb
SPRING_DATASOURCE_USERNAME=testuser
SPRING_DATASOURCE_PASSWORD=testpass
HIKARI_MAX_POOL_SIZE=1500
HIKARI_MIN_IDLE=1500

SPRING_R2DBC_URL=r2dbc:postgresql://localhost:5432/testdb
SPRING_R2DBC_USERNAME=testuser
SPRING_R2DBC_PASSWORD=testpass
R2DBC_POOL_INITIAL_SIZE=1500
R2DBC_POOL_MAX_SIZE=1500

# Sleep na query (segundos) — 0.1 = 100ms
WORKLOAD_IO_DB_SLEEP_SECONDS=0.1
